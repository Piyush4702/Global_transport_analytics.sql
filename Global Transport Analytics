SELECT 
    c.carrier_name,
    COUNT(s.tracking_number) AS total_shipments,
    SUM(CASE WHEN s.shipment_status = 'Delivered' THEN 1 ELSE 0 END) AS delivered_count,
    SUM(CASE WHEN s.shipment_status = 'Delayed' THEN 1 ELSE 0 END) AS delayed_count,
    SUM(sc.total_cost) AS total_revenue
FROM carriers c
LEFT JOIN shipments s ON c.carrier_id = s.carrier_id
LEFT JOIN shipment_cost sc ON s.tracking_number = sc.tracking_number
GROUP BY c.carrier_name;

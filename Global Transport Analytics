CREATE TABLE carriers (
Carrier_ID INT AUTO_INCREMENT PRIMARY KEY,
Carrier_Name VARCHAR(50),
Country VARCHAR(50),
Service_Type VARCHAR(50),
Rating INT
);
CREATE TABLE Routes(
Route_ID INT AUTO_INCREMENT PRIMARY KEY,
Origin VARCHAR(50),
Destination VARCHAR(50),
Estimated_Date DATE
);
CREATE TABLE Shipments(
Tracking_Number INT PRIMARY KEY AUTO_INCREMENT,
Carrier_ID INT,
Route_ID INT,
Dispatch_Date DATE NOT NULL,
Estimated_Delivery_Date DATE NOT NULL,
Actual_Delivery_Date DATE,
Shipment_Status VARCHAR(30) DEFAULT "In Transit",
FOREIGN KEY (Carrier_ID) REFERENCES Carriers(Carrier_ID) ON DELETE SET NULL,
FOREIGN KEY(Route_ID) REFERENCES Routes(Route_ID) ON DELETE SET NULL
);

CREATE TABLE Shipment_Cost(
Shipment_Weight DECIMAL (10,2) NOT NULL,
Tracking_Number INT,
Fuel_Surcharge INT,
Total_Cost DECIMAL (10,2) NOT NULL,
FOREIGN KEY (Tracking_Number) REFERENCES Shipments(Tracking_Number) ON DELETE SET NULL);

DROP TABLE IF EXISTS Shipment_Cost;
DROP TABLE IF EXISTS Shipments;
DROP TABLE IF EXISTS Routes;
DROP TABLE IF EXISTS Carriers;

